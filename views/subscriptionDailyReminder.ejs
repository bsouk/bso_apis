<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscription Reminder - BSO Services</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>This is a friendly reminder that your subscription is currently suspended and requires your attention.</p>

                            <!-- Status Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #856404;">Account Status: Suspended</strong><br /><br />
                                        <strong>Plan:</strong> <%= planName %><br />
                                        <strong>Outstanding Amount:</strong> <%= currency %> <%= amount %><br />
                                        <strong>Suspended Since:</strong> <%= suspensionDate %>
                                    </td>
                                </tr>
                            </table>

                            <p>Your <%= planName %> subscription is currently suspended due to payment issues. We're here to help you get back to enjoying all the features you love!</p>

                            <!-- Features Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #f8f9fa; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #055a90;">✨ Features Waiting for You:</strong><br /><br />
                                        <% if (benefits && benefits.length > 0) { %>
                                            <% benefits.forEach(function(benefit) { %>
                                                • <%= benefit %><br />
                                            <% }); %>
                                        <% } else { %>
                                            • Full access to all features<br />
                                            • Priority customer support<br />
                                            • Continuous service without interruption<br />
                                            • Access to latest updates and improvements
                                        <% } %>
                                    </td>
                                </tr>
                            </table>

                            <!-- Button -->
                            <p style="text-align: center;">
                                <a href="<%= website_url %>/my-account"
                                    style="display: inline-block; padding: 14px 28px; background-color: #055a90; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    Reactivate My Subscription
                                </a>
                            </p>

                            <!-- Warning Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #ffebee; border-left: 4px solid #f44336; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #c62828;">⚠️ Important:</strong> If payment is not received within 7 days of suspension, your subscription will be cancelled and your data may be removed.
                                    </td>
                                </tr>
                            </table>

                            <p style="margin-top: 30px;">Need help? We're here! Contact us at <a href="mailto:<%= supportEmail %>" style="color: #055a90;"><%= supportEmail %></a></p>

                            <p>Best regards,<br /><strong>Blue Sky Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
