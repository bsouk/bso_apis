<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscription Suspended - BSO Services</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#6c757d" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>Your subscription has been temporarily suspended due to payment failure after multiple retry attempts.</p>

                            <!-- Account Status Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #fff3cd; border-left: 4px solid #ff9800; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #f57c00;">Account Status</strong><br /><br />
                                        <strong>Plan:</strong> <%= planName %><br />
                                        <strong>Amount Due:</strong> <%= currency %> <%= amount %><br />
                                        <strong>Suspended On:</strong> <%= suspensionDate %>
                                    </td>
                                </tr>
                            </table>

                            <!-- Data Safety Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #e3f2fd; border-left: 4px solid #2196f3; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #1976d2;">🛡️ Your Data is Safe!</strong><br /><br />
                                        We'll keep your account data for 30 days. You can reactivate your subscription anytime during this period.
                                    </td>
                                </tr>
                            </table>

                            <p><strong>To reactivate your subscription:</strong></p>
                            <ol style="color: #555555; line-height: 1.8;">
                                <li>Click the button below to update your payment method</li>
                                <li>Pay the outstanding amount</li>
                                <li>Your subscription will be reactivated immediately</li>
                            </ol>

                            <!-- Button -->
                            <p style="text-align: center;">
                                <a href="<%= website_url %>/my-account"
                                    style="display: inline-block; padding: 14px 28px; background-color: #ff9800; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    Reactivate Subscription
                                </a>
                            </p>

                            <p style="margin-top: 30px;">Need a different plan or have questions? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #ff9800;"><%= supportEmail %></a></p>

                            <p>Best regards,<br /><strong>Blue Sky Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
