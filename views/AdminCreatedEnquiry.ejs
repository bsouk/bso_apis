<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enquiry Created Successfully - Blue Sky</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>Your enquiry has been created successfully! Here are the details:</p>

                            <!-- Enquiry Info Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #eef6fb; border-left: 4px solid #055a90; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong>Enquiry ID:</strong> <%= enquiry.enquiry_unique_id %><br />
                                        <strong>Enquiry Number:</strong> <%= enquiry.enquiry_number %><br />
                                        <strong>Priority:</strong> <%= enquiry.priority %><br />
                                        <strong>Created On:</strong> <%= new Date(enquiry.createdAt).toDateString() %><br />
                                        <strong>Expiry Date:</strong> <%= new Date(enquiry.expiry_date).toDateString() %>
                                    </td>
                                </tr>
                            </table>

                            <% 
                            // Check if shipping address has actual content
                            var hasShippingAddress = enquiry.shipping_address && (
                                enquiry.shipping_address.first_name ||
                                enquiry.shipping_address.last_name ||
                                enquiry.shipping_address.company_name ||
                                (enquiry.shipping_address.address && (
                                    enquiry.shipping_address.address.address_line_1 ||
                                    (enquiry.shipping_address.address.city && enquiry.shipping_address.address.city.name) ||
                                    (enquiry.shipping_address.address.state && enquiry.shipping_address.address.state.name) ||
                                    (enquiry.shipping_address.address.country && enquiry.shipping_address.address.country.name)
                                ))
                            );
                            %>
                            <% if (hasShippingAddress) { %>
                            <!-- Shipping Address -->
                            <h2 style="font-size: 18px; color: #055a90; border-bottom: 1px solid #e6e6e6; padding-bottom: 8px; margin-top: 20px;">
                                Shipping Address</h2>
                            <table width="100%" cellpadding="10" cellspacing="0"
                                style="border: 1px solid #e6e6e6; border-radius: 6px; background-color: #fdfdfd; margin-bottom: 20px;">
                                <tr>
                                    <td style="padding: 15px;">
                                        <% 
                                        var addressParts = [];
                                        if (enquiry.shipping_address.first_name || enquiry.shipping_address.last_name) {
                                            addressParts.push('<strong>' + [enquiry.shipping_address.first_name, enquiry.shipping_address.last_name].filter(Boolean).join(' ') + '</strong>');
                                        }
                                        if (enquiry.shipping_address.company_name) {
                                            addressParts.push(enquiry.shipping_address.company_name);
                                        }
                                        if (enquiry.shipping_address.address && enquiry.shipping_address.address.address_line_1) {
                                            addressParts.push(enquiry.shipping_address.address.address_line_1);
                                        }
                                        var locationParts = [];
                                        if (enquiry.shipping_address.address && enquiry.shipping_address.address.city && enquiry.shipping_address.address.city.name) {
                                            locationParts.push(enquiry.shipping_address.address.city.name);
                                        }
                                        if (enquiry.shipping_address.address && enquiry.shipping_address.address.state && enquiry.shipping_address.address.state.name) {
                                            locationParts.push(enquiry.shipping_address.address.state.name);
                                        }
                                        if (enquiry.shipping_address.address && enquiry.shipping_address.address.country && enquiry.shipping_address.address.country.name) {
                                            locationParts.push(enquiry.shipping_address.address.country.name);
                                        }
                                        if (locationParts.length > 0) {
                                            addressParts.push(locationParts.join(', '));
                                        }
                                        if (enquiry.shipping_address.address && enquiry.shipping_address.address.pin_code) {
                                            addressParts.push('PIN: ' + enquiry.shipping_address.address.pin_code);
                                        }
                                        %>
                                        <%- addressParts.join('<br />') %>
                                        <% if (enquiry.shipping_address.phone_number) { %>
                                        <br /><strong>Phone:</strong> <%= enquiry.shipping_address.phone_number %>
                                        <% } %>
                                        <% if (enquiry.shipping_address.email) { %>
                                        <br /><strong>Email:</strong> <%= enquiry.shipping_address.email %>
                                        <% } %>
                                    </td>
                                </tr>
                            </table>
                            <% } %>

                            <!-- Items -->
                            <% if (enquiry.enquiry_items && enquiry.enquiry_items.length> 0) { %>
                                <h2 style="font-size: 18px; color: #055a90; border-bottom: 1px solid #e6e6e6; padding-bottom: 8px;">
                                    Item Details</h2>
                                <% enquiry.enquiry_items.forEach(function(item, index) { %>
                                    <table width="100%" cellpadding="10" cellspacing="0"
                                        style="border: 1px solid #e6e6e6; border-radius: 6px; background-color: #fdfdfd; margin-bottom: 20px;">
                                        <tr>
                                            <td><strong>Item #<%= index + 1 %></strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Brand:</strong> <%= item.brand %></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Part No:</strong> <%= item.part_no %></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Description:</strong> <%= item.description %></td>
                                        </tr>
                                        <% if (item.notes) { %>
                                        <tr>
                                            <td><strong>Notes:</strong> <%= item.notes %></td>
                                        </tr>
                                        <% } %>
                                        <tr>
                                            <td><strong>Quantity:</strong> <%= item.quantity.value %> units</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Condition:</strong>
                                                <% if (item.condition.new) { %>New<% } %>
                                                <% if (item.condition.reconditioned) { %>Reconditioned<% } %>
                                                <% if (item.condition.used) { %>Used<% } %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Manufacturer Type:</strong>
                                                <% if (item.manufacturer.original) { %>Original<% } %>
                                                <% if (item.manufacturer.oem) { %>OEM<% } %>
                                                <% if (item.manufacturer.aftermarket) { %>Aftermarket<% } %>
                                            </td>
                                        </tr>
                                    </table>
                                <% }); %>
                            <% } %>

                            <p style="background-color: #e8f5e9; border-left: 4px solid #4caf50; padding: 12px; margin: 20px 0;">
                                <strong>What's Next?</strong> Suppliers will now be able to view your enquiry and submit quotes. 
                                You will be notified when quotes are received. You can track and manage your enquiry from your dashboard.
                            </p>

                            <!-- View Button -->
                            <p>
                                <a href="<%= view_link %>"
                                    style="display: inline-block; padding: 12px 24px; background-color: #055a90; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    View Your Enquiry
                                </a>
                            </p>

                            <p style="margin-top: 30px;">We're committed to providing you with the best service possible!</p>
                            <p>Best regards,<br /><strong>Blue Sky Customer Support Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>

