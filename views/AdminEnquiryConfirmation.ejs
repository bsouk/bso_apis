<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manual Enquiry Created - Blue Sky</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Logo -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="padding: 20px;">
                            <img src="https://bsoservices.com/static/media/Logo.4e70e62dd8d9fc8f4ae4.png" alt="BSO Logo"
                                style="display: block; max-height: 60px; width: auto;" />
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= admin_name %>,</strong></p>

                            <p>You have successfully created a manual enquiry on behalf of the following buyer:</p>

                            <!-- Buyer Info Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #f0f0f0; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td>
                                        <strong>Buyer Name:</strong> <%= buyer_name %><br />
                                        <strong>Email:</strong> <%= buyer_email %><br />
                                        <% if (buyer_company) { %>
                                        <strong>Company:</strong> <%= buyer_company %>
                                        <% } %>
                                    </td>
                                </tr>
                            </table>

                            <!-- Enquiry Info Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #eef6fb; border-left: 4px solid #055a90; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong>Enquiry ID:</strong> <%= enquiry.enquiry_unique_id %><br />
                                        <strong>Enquiry Number:</strong> <%= enquiry.enquiry_number %><br />
                                        <strong>Priority:</strong> <%= enquiry.priority %><br />
                                        <strong>Number of Items:</strong> <%= enquiry.enquiry_items.length %><br />
                                        <strong>Expiry Date:</strong> <%= new Date(enquiry.expiry_date).toDateString() %>
                                    </td>
                                </tr>
                            </table>

                            <!-- Quick Summary -->
                            <% if (enquiry.enquiry_items && enquiry.enquiry_items.length > 0) { %>
                                <h3 style="font-size: 16px; color: #055a90;">Items Summary:</h3>
                                <ul style="margin: 10px 0; padding-left: 20px;">
                                    <% enquiry.enquiry_items.forEach(function(item, index) { %>
                                        <li style="margin-bottom: 8px;">
                                            <strong><%= item.brand %></strong> - <%= item.part_no %>
                                            (Qty: <%= item.quantity.value %>)
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } %>

                            <table width="100%" cellpadding="12" cellspacing="0"
                                style="background-color: #d4edda; border-left: 4px solid #28a745; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 14px; color: #155724;">
                                        ✅ <strong>Buyer Notification Sent:</strong> The buyer has been notified via email about this enquiry.
                                    </td>
                                </tr>
                            </table>

                            <!-- View Button -->
                            <p>
                                <a href="<%= view_link %>"
                                    style="display: inline-block; padding: 12px 24px; background-color: #055a90; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    View Enquiry Details in Admin Panel
                                </a>
                            </p>

                            <p style="margin-top: 30px;">Thank you for managing enquiries efficiently!</p>
                            <p>Best regards,<br /><strong>BSO Admin System</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>

