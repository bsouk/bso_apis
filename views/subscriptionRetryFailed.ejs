<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Retry - BSO Services</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#f5576c" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>We attempted to process your subscription payment again, but unfortunately it was unsuccessful.</p>

                            <!-- Warning Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #ffebee; border-left: 4px solid #f44336; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #c62828;">⚠️ Payment Retry Unsuccessful</strong><br /><br />
                                        You have <strong><%= daysUntilSuspension %> days</strong> left until your subscription is temporarily suspended.
                                    </td>
                                </tr>
                            </table>

                            <!-- Payment Details -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #f8f9fa; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong>Plan:</strong> <%= planName %><br />
                                        <strong>Amount Due:</strong> <%= currency %> <%= amount %><br />
                                        <strong>Next Automatic Retry:</strong> <%= nextRetryDate %>
                                    </td>
                                </tr>
                            </table>

                            <!-- Button -->
                            <p style="text-align: center;">
                                <% const payLink = typeof paymentLink !== 'undefined' && paymentLink ? paymentLink : `${website_url}/my-account/invoices`; %>
                                <a href="<%= payLink %>"
                                    style="display: inline-block; padding: 14px 28px; background-color: #f5576c; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    Update Payment Method & Pay Now
                                </a>
                            </p>

                            <!-- Tip Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #e3f2fd; border-left: 4px solid #2196f3; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #1976d2;">💡 Tip:</strong> To avoid service interruption, please update your payment method or pay manually using the button above.
                                    </td>
                                </tr>
                            </table>

                            <p style="margin-top: 30px;">Need help? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #f5576c;"><%= supportEmail %></a></p>

                            <p>Best regards,<br /><strong>Blue Sky Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
