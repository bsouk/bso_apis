<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Retry Failed - Blue Sky Outsourcing</title>
    <style>
        body { margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f4f4; }
        .email-container { max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .header { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 30px 20px; text-align: center; color: #ffffff; }
        .header h1 { margin: 0; font-size: 24px; font-weight: 600; }
        .alert-icon { font-size: 48px; margin-bottom: 10px; }
        .content { padding: 40px 30px; }
        .greeting { font-size: 18px; color: #333333; margin-bottom: 20px; }
        .message { font-size: 16px; line-height: 1.6; color: #555555; margin-bottom: 25px; }
        .warning-box { background-color: #fff3cd; border-left: 4px solid #ff5252; padding: 20px; margin: 25px 0; border-radius: 4px; }
        .warning-box h3 { margin: 0 0 10px 0; color: #c62828; font-size: 18px; }
        .info-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e0e0e0; }
        .info-label { font-weight: 600; color: #333333; }
        .info-value { color: #555555; }
        .cta-button { display: inline-block; padding: 15px 40px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: #ffffff !important; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; margin: 10px 5px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .timeline { background-color: #f8f9fa; padding: 20px; margin: 25px 0; border-radius: 4px; }
        .timeline-item { padding: 10px 0; border-left: 3px solid #e0e0e0; padding-left: 15px; margin-left: 10px; }
        .timeline-item.completed { border-left-color: #ff5252; }
        .timeline-item.current { border-left-color: #ffc107; font-weight: 600; }
        .timeline-item.pending { border-left-color: #e0e0e0; color: #999999; }
        .footer { background-color: #f8f9fa; padding: 20px; text-align: center; font-size: 14px; color: #777777; }
        .footer a { color: #f5576c; text-decoration: none; }
        @media only screen and (max-width: 600px) { .content { padding: 30px 20px; } .cta-button { display: block; margin: 10px 0; } }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div class="alert-icon">⏰</div>
            <h1>Payment Retry Failed</h1>
        </div>
        
        <div class="content">
            <div class="greeting">Hi <%= name %>,</div>
            
            <div class="message">
                We attempted to process your subscription payment again, but unfortunately it was unsuccessful.
            </div>
            
            <div class="warning-box">
                <h3>⚠️ Attempt <%= attemptNumber %> of <%= maxAttempts %> Failed</h3>
                <p style="margin: 10px 0 0 0; color: #555555;">
                    You have <strong><%= daysUntilSuspension %> days</strong> left until your subscription is temporarily suspended.
                </p>
            </div>
            
            <div class="timeline">
                <h3 style="margin: 0 0 15px 0; color: #333333;">Payment Attempts</h3>
                <% for(let i = 1; i <= maxAttempts; i++) { %>
                    <div class="timeline-item <%= i < attemptNumber ? 'completed' : i === attemptNumber ? 'current' : 'pending' %>">
                        <%= i < attemptNumber ? '✗' : i === attemptNumber ? '✗' : '○' %> 
                        Attempt <%= i %> <%= i < attemptNumber ? '- Failed' : i === attemptNumber ? '- Failed (Today)' : '- Scheduled' %>
                    </div>
                <% } %>
            </div>
            
            <div class="message">
                <strong>Next automatic retry:</strong> <%= nextRetryDate %><br>
                <strong>Amount due:</strong> <%= currency %> <%= amount %>
            </div>
            
            <div style="text-align: center; margin: 30px 0;">
                <a href="<%= paymentLink %>" class="cta-button">Update Payment Method & Pay Now</a>
            </div>
            
            <div class="message" style="background-color: #e3f2fd; padding: 15px; border-radius: 4px;">
                <strong>💡 Tip:</strong> To avoid service interruption, please update your payment method or pay manually using the button above.
            </div>
            
            <div class="message" style="font-size: 14px;">
                Need help? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #f5576c;"><%= supportEmail %></a>
            </div>
        </div>
        
        <div class="footer">
            <p><strong>Blue Sky Outsourcing</strong></p>
            <p>© <%= new Date().getFullYear() %> Blue Sky Outsourcing. All rights reserved.</p>
        </div>
    </div>
</body>
</html>

