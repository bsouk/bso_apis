<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Password Reset Request - Blue Sky</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700">
</head>
<body style="width:100%; font-family: Arial; height:100%; background:#F0F0F0; color: #191b1f;">
	<table cellspacing="0" cellpadding="0" width="800" style="background-color: #fff;padding: 0;border-collapse:collapse;margin: 0 auto; " border="0">
		<tbody>
			<tr>
				<td align="center" bgcolor="#055a90" style="padding: 25px 20px;">
					<h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
				</td>
			</tr>
			<tr>
				<td height="20"></td>
			</tr>
			<tr>
				<td style="padding: 0 40px;font-size: 17px;text-align: center;line-height: 25px; "><b>Dear <%= name %></b>
				</td>
			</tr>
			<tr>
				<td height="20"></td>
			</tr>
			<tr>
				<td style="padding: 0 40px;font-size: 17px;line-height: 25px; ">
					Your password reset request has been received and sent to the administrator for approval. You will receive an email with a reset link once a super admin approves your request.
				</td>
			</tr>
			<tr>
				<td height="20"></td>
			</tr>
			<tr>
				<td style="padding: 0 40px;font-size: 17px;line-height: 25px; ">
					If you did not request this, please contact support or ignore this email.
				</td>
			</tr>
			<tr>
				<td height="20"></td>
			</tr>
			<tr>
				<td style="padding: 0px 40px;font-size: 17px;line-height: 25px; ">Best regards,<br>Blue Sky Team
				</td>
			</tr>
			<tr>
				<td height="20"></td>
			</tr>
			<tr>
				<td height="15" style="background-color:#0000FF;"></td>
			</tr>
			<tr>
				<td style="text-align: center;color: #fff;font-size: 14px;background-color:#0000FF;">Copyright © <%= new Date().getFullYear(); %>, Blue Sky All Rights Reserved.</td>
			</tr>
			<tr>
				<td height="15" style="background-color:#0000FF;"></td>
			</tr>
		</tbody>
	</table>
</body>
</html>
