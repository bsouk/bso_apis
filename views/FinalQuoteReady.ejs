<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Final Quote Ready - Blue Sky</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>Great news! Your final quote is ready for enquiry <strong>#<%= enquiry_id %></strong>.</p>

                            <p>Our team has reviewed and finalized the pricing for your enquiry. Here's a summary:</p>

                            <!-- Quote Summary Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #e8f5e9; border-left: 4px solid #4caf50; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong>Enquiry ID:</strong> <%= enquiry_id %><br />
                                        <strong>Product Price:</strong> <%= admin_price %><br />
                                        <strong>Logistics Charges:</strong> <%= logistics_price %><br />
                                        <strong style="font-size: 18px; color: #2e7d32;">Grand Total:</strong> <span style="font-size: 18px; color: #2e7d32;"><%= grand_total %></span><br />
                                        <% if (payment_terms) { %>
                                        <strong>Payment Terms:</strong> <%= payment_terms %>
                                        <% } %>
                                    </td>
                                </tr>
                            </table>

                            <p style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 12px; margin: 20px 0;">
                                <strong>Next Step:</strong> Please review the final quote and proceed with the payment to confirm your order.
                            </p>

                            <!-- View Button -->
                            <p>
                                <a href="<%= view_link %>"
                                    style="display: inline-block; padding: 12px 24px; background-color: #4caf50; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    View Final Quote
                                </a>
                            </p>

                            <p style="margin-top: 30px;">If you have any questions about your quote, please don't hesitate to contact us.</p>
                            <p>Best regards,<br /><strong>Blue Sky Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>




