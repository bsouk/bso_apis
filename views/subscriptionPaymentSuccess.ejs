<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Successful - BSO Services</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#28a745" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>Great news! Your payment has been processed successfully. 🎉</p>

                            <!-- Success Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #d4edda; border-left: 4px solid #28a745; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #155724;">✓ Your Subscription is Active</strong><br /><br />
                                        <strong>Plan:</strong> <%= planName %><br />
                                        <strong>Amount Paid:</strong> <%= currency %> <%= amount %><br />
                                        <strong>Next Billing Date:</strong> <%= nextBillingDate %>
                                    </td>
                                </tr>
                            </table>

                            <p>Thank you for your patience! Your subscription is now fully active and you can continue enjoying all features without interruption.</p>

                            <!-- Button -->
                            <p style="text-align: center;">
                                <a href="<%= website_url %>/my-account/invoices"
                                    style="display: inline-block; padding: 14px 28px; background-color: #28a745; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                                    View My Invoices
                                </a>
                            </p>

                            <p style="margin-top: 30px;">Questions? Contact us at <a href="mailto:<%= supportEmail %>" style="color: #28a745;"><%= supportEmail %></a></p>

                            <p>Best regards,<br /><strong>Blue Sky Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
