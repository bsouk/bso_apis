<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Failed - BSO Services</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
        <tr>
            <td align="center">
                <table width="700" cellpadding="0" cellspacing="0" border="0"
                    style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

                    <!-- Header with Brand Name -->
                    <tr>
                        <td align="center" bgcolor="#dc3545" style="padding: 25px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold; letter-spacing: 2px; font-family: Arial, sans-serif;">Blue Sky</h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
                            <p><strong>Hello <%= name %>,</strong></p>

                            <p>We tried to process your subscription payment but unfortunately it didn't go through.</p>

                            <!-- Payment Details Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #856404;">Payment Details</strong><br /><br />
                                        <strong>Plan:</strong> <%= planName %><br />
                                        <strong>Amount:</strong> <%= currency %> <%= amount %><br />
                                        <strong>Reason:</strong> <%= failureReason %>
                                    </td>
                                </tr>
                            </table>

                            <p><strong>Don't worry!</strong> We'll automatically try again on <strong><%= nextRetryDate %></strong>. However, to ensure uninterrupted service, we recommend updating your payment method now.</p>

                            <!-- Buttons -->
                            <p style="text-align: center;">
                                <a href="<%= website_url %>/my-account"
                                    style="display: inline-block; padding: 14px 28px; background-color: #055a90; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold; margin: 5px;">
                                    Pay Now
                                </a>
                                <a href="<%= website_url %>/my-account"
                                    style="display: inline-block; padding: 14px 28px; background-color: #ffffff; color: #055a90; text-decoration: none; border-radius: 4px; font-weight: bold; border: 2px solid #055a90; margin: 5px;">
                                    Update Payment Method
                                </a>
                            </p>

                            <!-- What Happens Next Box -->
                            <table width="100%" cellpadding="15" cellspacing="0"
                                style="background-color: #e3f2fd; border-left: 4px solid #2196f3; border-radius: 4px; margin: 20px 0;">
                                <tr>
                                    <td style="font-size: 15px;">
                                        <strong style="color: #1976d2;">What Happens Next?</strong><br /><br />
                                        • Your subscription remains <strong>active</strong> during the grace period (6 days)<br />
                                        • We'll automatically retry payment on <strong>Day 2, 4, and 6</strong><br />
                                        • You can pay anytime using the "Pay Now" button above<br />
                                        • If all retries fail, your subscription will be temporarily suspended
                                    </td>
                                </tr>
                            </table>

                            <p style="margin-top: 30px;">Need help? Our support team is here for you at <a href="mailto:<%= supportEmail %>" style="color: #055a90;"><%= supportEmail %></a></p>

                            <p>Best regards,<br /><strong>Blue Sky Team</strong></p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
                            &copy; <%= new Date().getFullYear() %> Blue Sky. All rights reserved.<br />
                            <a href="<%= website_url %>" style="color: #ffffff; text-decoration: none;">Visit Website</a> | 
                            <a href="<%= website_url %>/contact-us" style="color: #ffffff; text-decoration: none;">Contact Support</a>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
