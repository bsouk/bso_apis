<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Enquiry Available - BSO Services</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f7f9; font-family: Arial, sans-serif; color: #222021;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f9; padding: 30px 0;">
    <tr>
      <td align="center">
        <table width="700" cellpadding="0" cellspacing="0" border="0"
          style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.05);">

          <!-- Header with Logo -->
          <tr>
            <td align="center" bgcolor="#055a90" style="padding: 20px;">
              <img src="https://bsoservices.com/static/media/Logo.4e70e62dd8d9fc8f4ae4.png" alt="BSO Logo"
                style="display: block; max-height: 60px; width: auto;" />
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 30px 40px; font-size: 16px; line-height: 1.7;">
              <p><strong>Hello <%= supplier_name %>,</strong></p>

              <p>A new enquiry is now available for you to review and quote on. Here are the details:</p>

              <!-- Enquiry Summary Box -->
              <table width="100%" cellpadding="15" cellspacing="0"
                style="background-color: #eef6fb; border-left: 4px solid #055a90; border-radius: 4px; margin: 20px 0;">
                <tr>
                  <td style="font-size: 15px;">
                    <strong>Enquiry ID:</strong> <%= enquiry.enquiry_unique_id %><br />
                    <strong>Enquiry Number:</strong> <%= enquiry.enquiry_number %><br />
                    <strong>Buyer:</strong> <%= buyer_name %><br />
                    <strong>Priority:</strong> <%= enquiry.priority %><br />
                    <strong>Expiry Date:</strong> <%= new Date(enquiry.expiry_date).toDateString() %><br />
                    <strong>Currency:</strong> <%= enquiry.currency %>
                  </td>
                </tr>
              </table>

              <!-- Shipping Address -->
              <% if (enquiry.shipping_address) { %>
                <h3 style="font-size: 16px; color: #055a90; margin-top: 25px; margin-bottom: 10px;">Shipping Address</h3>
                <table width="100%" cellpadding="10" cellspacing="0"
                  style="border: 1px solid #e6e6e6; border-radius: 6px; background-color: #fdfdfd; margin-bottom: 20px;">
                  <tr>
                    <td>
                      <%= enquiry.shipping_address.first_name %> <%= enquiry.shipping_address.last_name %><br />
                      <% if (enquiry.shipping_address.company_name) { %>
                        <%= enquiry.shipping_address.company_name %><br />
                      <% } %>
                      <%= enquiry.shipping_address.address?.address_line_1 %><br />
                      <% if (enquiry.shipping_address.address?.address_line_2) { %>
                        <%= enquiry.shipping_address.address.address_line_2 %><br />
                      <% } %>
                      <%= enquiry.shipping_address.address?.city?.name || enquiry.shipping_address.address?.city %>,
                      <%= enquiry.shipping_address.address?.state?.name || enquiry.shipping_address.address?.state %>
                      <%= enquiry.shipping_address.address?.pin_code %><br />
                      <%= enquiry.shipping_address.address?.country?.name || enquiry.shipping_address.address?.country %>
                    </td>
                  </tr>
                </table>
              <% } %>

              <!-- Item Details -->
              <% if (enquiry.enquiry_items && enquiry.enquiry_items.length > 0) { %>
                <h3 style="font-size: 16px; color: #055a90; margin-top: 25px; margin-bottom: 10px;">Item Details</h3>
                <% enquiry.enquiry_items.forEach(function(item, index) { %>
                  <table width="100%" cellpadding="10" cellspacing="0"
                    style="border: 1px solid #e6e6e6; border-radius: 6px; background-color: #fdfdfd; margin-bottom: 15px;">
                    <tr>
                      <td style="background-color: #f8f9fa; padding: 8px; font-weight: bold; border-bottom: 1px solid #e6e6e6;">
                        Item #<%= index + 1 %>
                      </td>
                    </tr>
                    <tr>
                      <td><strong>Brand:</strong> <%= item.brand %></td>
                    </tr>
                    <tr>
                      <td><strong>Part Number:</strong> <%= item.part_no %></td>
                    </tr>
                    <tr>
                      <td><strong>Description:</strong> <%= item.description %></td>
                    </tr>
                    <% if (item.notes) { %>
                      <tr>
                        <td><strong>Notes:</strong> <%= item.notes %></td>
                      </tr>
                    <% } %>
                    <tr>
                      <td><strong>Quantity:</strong> <%= item.quantity.value %> units</td>
                    </tr>
                    <tr>
                      <td>
                        <strong>Condition:</strong>
                        <% if (item.condition.new) { %>New<% } else if (item.condition.reconditioned) { %>Reconditioned<% } else if (item.condition.used) { %>Used<% } %>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <strong>Manufacturer Type:</strong>
                        <% if (item.manufacturer.original?.selected) { %>Original<% } else if (item.manufacturer.oem?.selected) { %>OEM<% } else if (item.manufacturer.aftermarket?.selected) { %>Aftermarket<% } %>
                      </td>
                    </tr>
                    <% if (item.attachment && item.attachment.length > 0) { %>
                      <tr>
                        <td>
                          <strong>Attachment:</strong>
                          <a href="<%= storage_url %><%= item.attachment[0] %>" target="_blank" style="color: #055a90;">View Attachment</a>
                        </td>
                      </tr>
                    <% } %>
                  </table>
                <% }); %>
              <% } %>

              <p style="margin-top: 25px;">Please review the enquiry details and submit your quote before the expiry date.</p>

              <!-- Action Button -->
              <p style="margin-top: 20px;">
                <a href="<%= view_link %>"
                  style="display: inline-block; padding: 12px 24px; background-color: #055a90; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: bold;">
                  View & Submit Quote
                </a>
              </p>

              <p style="margin-top: 30px;">Thank you for being a valued partner with BSO Services!</p>
              <p>Best regards,<br /><strong>BSO Services Team</strong></p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" bgcolor="#055a90" style="color: #ffffff; padding: 20px; font-size: 14px;">
              &copy; <%= new Date().getFullYear() %> BSO Services. All rights reserved.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>

</html>


